{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReelPlay",
  "version": "0.1.0",
  "identifier": "com.reelplay.localplayer",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run frontend-build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ReelPlay",
        "width": 1200,
        "height": 750
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}